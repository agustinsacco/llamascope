Screen {
    background: #0a0a0a;
}

Header {
    dock: top;
    height: 3;
    content-align: center middle;
    background: #0047ab;
    color: white;
    text-style: bold;
}

Footer {
    dock: bottom;
    height: 1;
    background: #1a1a1a;
    color: #666;
}

#sidebar {
    width: 30%;
    height: 100%;
    dock: left;
    border: panel #333;
}

#main-content {
    width: 70%;
    height: 100%;
    border: panel #333;
}

.widget-container {
    height: auto;
    margin-bottom: 1;
    padding: 1;
    border: round #222;
}

.half-width {
    width: 50%;
}

.metric-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.metric-value {
    text-style: bold;
    color: white;
    text-align: right;
}

#logs {
    height: 8;
    dock: bottom;
    border-top: panel #333;
    background: #050505;
}

DataTable {
    height: 10;
    border: round #222;
}

#active-slots {
    height: 1fr;
    overflow-y: scroll;
}

.slot-card {
    border: round #333;
    margin-bottom: 1;
    height: 12;
}

.graph-container {
    height: 1fr;
}
